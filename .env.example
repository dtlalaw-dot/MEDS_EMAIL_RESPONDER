# ============================================
# Microsoft 365 / Outlook Configuration
# ============================================
# Azure AD App Registration credentials
# Create at: https://portal.azure.com > Azure Active Directory > App Registrations
MS_CLIENT_ID=your-azure-app-client-id
MS_CLIENT_SECRET=your-azure-app-client-secret
MS_TENANT_ID=your-azure-tenant-id

# The email address to monitor for incoming emails
MONITORED_EMAIL=intake@yourfirm.com

# ============================================
# Filevine Configuration
# ============================================
# Your Filevine login credentials
FILEVINE_URL=https://app.filevine.com
FILEVINE_USERNAME=your-filevine-username
FILEVINE_PASSWORD=your-filevine-password

# ============================================
# Polling Configuration
# ============================================
# How often to check for new emails (in seconds)
POLL_INTERVAL_SECONDS=120

# ============================================
# Response Configuration
# ============================================
# Firm name for the auto-response email
FIRM_NAME=Your Law Firm Name
FIRM_PHONE=(555) 555-5555
FIRM_EMAIL=info@yourfirm.com
